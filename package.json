{
  "name": "omp-lockin",
  "version": "0.1.0",
  "description": "Temporarily force every participating OMP workflow session to its highest supported reasoning effort.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/controller.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "omp",
    "omp-extension",
    "oh-my-pi",
    "reasoning",
    "thinking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarcur1/omp-lockin.git"
  },
  "bugs": {
    "url": "https://github.com/jarcur1/omp-lockin/issues"
  },
  "homepage": "https://github.com/jarcur1/omp-lockin#readme",
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.6.0 <19"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "^18.6.0",
    "@oh-my-pi/pi-coding-agent": "^18.6.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
